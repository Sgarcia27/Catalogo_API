    {
      "name": "Rechazar token vencido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.environment.get('jwtSecret');",
              "if (!secret) { throw new Error('Completa jwtSecret en el entorno local para firmar el token vencido.'); }",
              "function base64url(value) {",
              "  return CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(value)).replace(/=+$/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "const header = base64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
              "const payload = base64url(JSON.stringify({ id: 1, role: 'usuario', iat: Math.floor(Date.now() / 1000) - 120, exp: Math.floor(Date.now() / 1000) - 60 }));",
              "const unsigned = header + '.' + payload;",
              "const signature = CryptoJS.enc.Base64.stringify(CryptoJS.HmacSHA256(unsigned, secret)).replace(/=+$/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "pm.environment.set('expiredToken', unsigned + '.' + signature);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token firmado vencido devuelve 401', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().message).to.eql('Token expirado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expiredToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/favoritos"
      }
    },
